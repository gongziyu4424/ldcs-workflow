# 模型接入配置（复制本文件为 .env 后填写）
# 不建 .env 也能跑，默认 mock 模式：用本地规则抽取，不联网、不花钱，适合先跑通流程。

# mock = 本地规则抽取；openai = 走 OpenAI 兼容接口
LLM_MODE=mock

# ---- 阿里云百炼 Token Plan ----
# ⚠️ 计费通道三者隔离，必须配套使用，混用会走错通道扣费或直接 401/403：
#    Token Plan      → key 以 sk-sp- 开头  + https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#    Coding Plan     → Coding Plan key     + https://coding.dashscope.aliyuncs.com/v1
#    按量付费（百炼）→ key 以 sk- 开头      + https://dashscope.aliyuncs.com/api/v1
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 模型名以你套餐里实际开通的为准，可在百炼控制台「我的订阅」查看
LLM_MODEL=qwen3.6-plus
